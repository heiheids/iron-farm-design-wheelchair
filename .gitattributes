# 统一换行符，避免不同系统提交时整个文件显示为改动
* text=auto

# 源码保持 LF
*.java   text eol=lf
*.gradle text eol=lf
*.json   text eol=lf
*.lang   text eol=lf
*.toml   text eol=lf

# Windows 脚本与文档保持 CRLF
*.ps1  text eol=crlf
*.txt  text eol=crlf
*.md   text eol=lf

# 二进制
*.jar  binary
*.png  binary
*.zip  binary
*.gz   binary